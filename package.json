{
  "name": "mino-consulting-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:project-preview": "vite build --base=/minoconsult/ && node scripts/copy-seo-routes.mjs --preview",
    "postbuild": "node scripts/copy-seo-routes.mjs && node scripts/validate-dist.mjs && node scripts/validate-internal-links.mjs && node scripts/test-content-quality.mjs && node scripts/check-performance-budgets.mjs",
    "validate:dist": "node scripts/validate-dist.mjs",
    "validate:links": "node scripts/validate-internal-links.mjs",
    "check:budgets": "node scripts/check-performance-budgets.mjs",
    "check:spacing": "node scripts/validate-spacing-tokens.mjs",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "test:a11y": "node scripts/test-accessibility.mjs",
    "test:privacy": "node scripts/test-privacy.mjs",
    "test:quality": "node scripts/test-production-quality.mjs",
    "test:spacing": "node scripts/test-spacing-layout.mjs",
    "test:refinements": "node scripts/test-focused-refinements.mjs",
    "test:content": "node scripts/test-content-quality.mjs",
    "test:dev": "node scripts/test-development.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.20",
    "gh-pages": "^6.3.0",
    "playwright-core": "^1.59.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^7.3.6"
  }
}
